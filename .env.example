# Environment Variables for redwan.work

# ==============================================
# Cloudflare Turnstile (Bot Protection)
# ==============================================
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
# Site key (public, used in the browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Secret key (server-only, NEVER expose in client code)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ==============================================
# Google Forms Integration
# ==============================================
# The form submission URL (formResponse endpoint)
# Example: https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse
GOOGLE_FORM_ACTION_URL=your_google_form_action_url_here

# ==============================================
# Google Blogger API
# ==============================================
# Base64-encoded Google service account credentials JSON
# Used for fetching blog posts from Blogger API
GOOGLE_CREDENTIALS_B64=your_base64_encoded_credentials_here

# Your Blogger Blog ID
BLOGGER_BLOG_ID=your_blogger_blog_id_here
