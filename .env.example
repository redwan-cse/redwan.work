# Environment Variables for redwan.work

# ==============================================
# Cloudflare Turnstile (Bot Protection)
# ==============================================
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
# Site key (public, used in the browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Secret key (server-only, NEVER expose in client code)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ==============================================
# Google Forms Integration
# ==============================================
# The form submission URL (formResponse endpoint)
# Example: https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse
GOOGLE_FORM_ACTION_URL=your_google_form_action_url_here

# ==============================================
# Google Blogger API
# ==============================================
# Base64-encoded Google service account credentials JSON
# Used for fetching blog posts from Blogger API
GOOGLE_CREDENTIALS_B64=your_base64_encoded_credentials_here

# Your Blogger Blog ID
BLOGGER_BLOG_ID=your_blogger_blog_id_here

# ==============================================
# Site
# ==============================================
# Public origin, used for canonical URLs / auth redirects
# Example: https://redwan.work or http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for POST /api/revalidate (sent as Authorization: Bearer ...)
REVALIDATION_SECRET=your_revalidation_secret_here

# ==============================================
# Supabase (auth + Postgres)
# ==============================================
# Project URL — Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (new format: sb_publishable_...)
# NEVER use the legacy anon JWT key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Service-role secret key (new format: sb_secret_...)
# SERVER-ONLY. Bypasses RLS. Never expose to the client or commit real values.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# ==============================================
# Cloudflare R2 (object storage)
# ==============================================
# Create via: dash.cloudflare.com > R2 > Manage API tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Bucket names (create both in the R2 dashboard)
R2_PUBLIC_BUCKET=redwan-work-public
R2_PRIVATE_BUCKET=redwan-work-private

# Custom domain bound to the PUBLIC bucket (CDN reads)
# Example: https://cdn.redwan.work
R2_PUBLIC_DOMAIN=https://cdn.redwan.work

# ==============================================
# Resend (transactional email)
# ==============================================
# API key from resend.com/api-keys (server-only)
RESEND_API_KEY=re_your_api_key_here

# Verified sender for lifecycle emails (requires DKIM on redwan.work)
RESEND_FROM_EMAIL="Redwan <no-reply@redwan.work>"
