# Environment Variables for redwan.work

# ==============================================
# Cloudflare Turnstile (Bot Protection)
# ==============================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ==============================================
# Site
# ==============================================
# Public origin, used for canonical URLs / auth redirects
# Example: https://redwan.work or http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Shared secret for POST /api/revalidate (sent as Authorization: Bearer ...)
REVALIDATION_SECRET=


# ==============================================
# Supabase (auth + Postgres)
# ==============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ==============================================
# Leads pipeline (/api/contact cutover)
# ==============================================
# Where contact-form leads are written: forms | supabase | both
LEADS_SINK=forms

# Salt used to hash submitter IPs before storage (never store raw IPs).
# Generate with: openssl rand -hex 32
LEAD_IP_HASH_SALT=

# ==============================================
# Cloudflare R2 (object storage)
# ==============================================
R2_ENDPOINT=
R2_PUBLIC_BUCKET=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=

# Custom domain bound to the PUBLIC bucket (CDN reads)
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# ==============================================
# Resend (transactional email)
# ==============================================
# API key from resend.com/api-keys (server-only)
RESEND_API_KEY=

# Verified sender for lifecycle emails (requires DKIM on redwan.work)
RESEND_FROM_EMAIL=


# ==============================================
# Google Forms Integration (Legacy)
# ==============================================
GOOGLE_FORM_ACTION_URL=

# ==============================================
# Google Blogger API
# ==============================================
# Base64-encoded Google service account credentials JSON
GOOGLE_CREDENTIALS_B64=
BLOGGER_BLOG_ID=
REVALIDATION_TOKEN=